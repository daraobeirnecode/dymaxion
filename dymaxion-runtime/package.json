{
  "name": "dymaxion-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Dymaxion GIS agent runtime — TypeScript + Vercel AI SDK, multi-gateway, skill-first",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "dymaxion": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:contracts": "tsx --test test/contracts.test.ts",
    "gisbench": "tsx src/gisbench/run.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.16",
    "@ai-sdk/azure": "4.0.17",
    "@ai-sdk/cohere": "4.0.11",
    "@ai-sdk/google": "4.0.18",
    "@ai-sdk/openai": "4.0.16",

    "@modelcontextprotocol/sdk": "^1.12.0",
    "ai": "7.0.31",
    "drizzle-orm": "0.45.2",
    "langfuse": "^3.35.0",
    "openid-client": "^6.5.0",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "tsx": "^4.19.0",
    "yaml": "^2.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@mastra/core": "1.51.0",
    "@types/node": "^22.13.0",
    "typescript": "^5.8.0"
  }
}
