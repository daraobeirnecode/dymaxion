{
  "name": "dymaxion-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Dymaxion GIS agent runtime — Mastra + Vercel AI SDK, multi-gateway, skill-first",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "dymaxion": "dist/cli.js"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/azure": "^2.0.0",
    "@ai-sdk/cohere": "^2.0.0",
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@mastra/core": "latest",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ai": "^5.0.0",
    "drizzle-orm": "^0.45.2",
    "langfuse": "^3.35.0",
    "openid-client": "^6.5.0",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "tsx": "^4.19.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  }
}
