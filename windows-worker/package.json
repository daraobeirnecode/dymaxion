{
  "name": "dymaxion-windows-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Dymaxion Windows Worker — ArcGIS Pro CLI + arcpy over HTTP",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
