# Dymaxion Windows Worker configuration.
# install.ps1 generates SHARED_WORKER_SECRET automatically — copy the value it
# prints into the runtime host's .env as WINDOWS_WORKER_SECRET.

# Bearer secret required on every request
SHARED_WORKER_SECRET=

# Optional comma-separated allowlist of runtime hosts/IPs permitted to call
# this worker (empty = any host that presents the secret; the firewall rule
# already restricts to Private + Domain network profiles)
ALLOWED_RUNTIME_HOSTS=

# Port (default 4444)
WORKER_PORT=4444

# Shared file-shuttle root (bind-mounted volume on single-machine topology,
# SMB share / synced folder on split-machine)
SHARED_DIR=C:\dymaxion-shared

# Hard transfer limits; request bodies are streamed and aborted above these.
WORKER_MAX_UPLOAD_BYTES=104857600
WORKER_MAX_DOWNLOAD_BYTES=104857600

# ArcGIS Pro python env (default install path)
ARCGISPRO_PYTHON=C:\Program Files\ArcGIS\Pro\bin\Python\envs\arcgispro-py3\python.exe

# CLI-Anything-Arcgis-Pro install location (install.ps1 default)
PRO_CLI_DIR=%USERPROFILE%\.dymaxion\cli-anything-arcgis-pro
