# ============================================================
# Dymaxion — environment configuration
# Copy to .env and fill in. install.sh / install.ps1 do this
# interactively and generate the random secrets for you.
# NEVER commit .env. Store encrypted (SOPS) if you back it up.
# ============================================================

# --- Core -----------------------------------------------------
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://dymaxion:${POSTGRES_PASSWORD}@dymaxion-postgres:5432/dymaxion

# Keep the dashboard on loopback and expose it only through Tailscale Serve.
# Tailscale Serve injects the authenticated Tailscale-User-Login header.
ADMIN_BIND_HOST=127.0.0.1
# Comma-separated stable Tailscale login(s) allowed to decide approvals.
DYMAXION_ADMIN_IDENTITIES=
# Shared admin-to-runtime bearer secret (generated by install.sh).
RUNTIME_INTERNAL_TOKEN=
# Trusted execution account/principal per destructive skill slug. These are
# identities, not credentials; absent mappings fail closed before approval.
DYMAXION_CREDENTIAL_IDENTITIES_JSON={}

# --- LLM providers --------------------------------------------
# Anthropic — API key (the only key-auth LLM provider by design)
ANTHROPIC_API_KEY=sk-ant-...

# Voyage — embeddings (voyage-3-large, 1024-dim)
VOYAGE_API_KEY=

# OpenAI — OAuth 2.0 (connect via admin dashboard → Providers)
OPENAI_OAUTH_CLIENT_ID=
OPENAI_OAUTH_CLIENT_SECRET=

# Google Gemini — OAuth 2.0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Azure OpenAI — OAuth 2.0 (Entra ID)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Cohere — OAuth 2.0
COHERE_OAUTH_CLIENT_ID=
COHERE_OAUTH_CLIENT_SECRET=

# Ollama — local, no auth (install on host: https://ollama.com)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OAuth token encryption key (32-byte hex; generated by installer)
OAUTH_TOKEN_ENCRYPTION_KEY=

# --- Gateways -------------------------------------------------
# Telegram (Sprint 1 default gateway)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_MAX_ATTACHMENT_BYTES=26214400

# Teams (Sprint 2 — stub)
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_TENANT_ID=

# Slack (Sprint 2 — stub)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Email (Sprint 3 — stub)
DYMAXION_EMAIL_ADDRESS=
DYMAXION_EMAIL_IMAP_HOST=
DYMAXION_EMAIL_IMAP_PORT=993
DYMAXION_EMAIL_SMTP_HOST=
DYMAXION_EMAIL_SMTP_PORT=587
DYMAXION_EMAIL_PASSWORD=

# ArcGIS Portal notifications (Sprint 4 — stub)
DYMAXION_ARCGIS_PORTAL_URL=
DYMAXION_ARCGIS_USERNAME=
DYMAXION_ARCGIS_PASSWORD=
DYMAXION_ARCGIS_NOTIFICATION_GROUP_ID=

# --- MCP servers ----------------------------------------------
ESRI_PORTAL_URL=
ESRI_CLIENT_ID=
ESRI_CLIENT_SECRET=
DYMAXION_POSTGIS_URL=postgres://dymaxion:${POSTGRES_PASSWORD}@dymaxion-postgres:5432/dymaxion
GITHUB_TOKEN=

# --- Observability (LangFuse) ---------------------------------
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Windows Worker (ArcGIS Pro CLI + arcpy) ------------------
# Topology A (Windows-only):  http://host.docker.internal:4444
# Topology B/C (Tailscale):   http://<windows-tailscale-ip>:4444
# Leave empty to disable ArcGIS-Pro-dependent skills.
WINDOWS_WORKER_URL=
WINDOWS_WORKER_SECRET=
