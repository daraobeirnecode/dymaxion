{
  "description": "Synthetic public Feature Layer for the basic attribute query task: three hydrants retrieved via canonical object-ID paging (maxRecordCount 2). All names, IDs, and values are invented; no real ArcGIS service was queried.",
  "routes": [
    {
      "url": "https://services.arcgis.com/synthorg/arcgis/rest/services/Hydrants/FeatureServer/0?f=json",
      "body_file": "layer-meta.json"
    },
    {
      "url": "https://services.arcgis.com/synthorg/arcgis/rest/services/Hydrants/FeatureServer/0/query",
      "method": "POST",
      "form": {
        "f": "json",
        "where": "1=1",
        "returnIdsOnly": "true",
        "returnGeometry": "false"
      },
      "body_file": "ids.json"
    },
    {
      "url": "https://services.arcgis.com/synthorg/arcgis/rest/services/Hydrants/FeatureServer/0/query",
      "method": "POST",
      "form": {
        "f": "json",
        "objectIds": "1,2",
        "outFields": "OBJECTID,STATUS",
        "returnGeometry": "false"
      },
      "body_file": "features-1-2.json"
    },
    {
      "url": "https://services.arcgis.com/synthorg/arcgis/rest/services/Hydrants/FeatureServer/0/query",
      "method": "POST",
      "form": {
        "f": "json",
        "objectIds": "3",
        "outFields": "OBJECTID,STATUS",
        "returnGeometry": "false"
      },
      "body_file": "features-3.json"
    }
  ]
}
